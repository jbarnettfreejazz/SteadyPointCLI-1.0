+// ─────────────────────────────────────────────────────────────────────
+// SteadyPoint patch (Nineteenth follow-up): recover from audio route
+// changes and interruptions. Upstream 0.4.18 registers no observers, so:
+//  - Switching output (e.g. connecting a Bluetooth speaker mid-session)
+//    can change the hardware sample rate / channel count. AVAudioEngine
+//    then STOPS ITSELF and posts AVAudioEngineConfigurationChangeNotification;
+//    nothing restarted it, so sonification went silent until the app
+//    rebuilt/resumed the engine (confirmed on-device).
+//  - A phone call / Siri / alarm interruption likewise stops the engine,
+//    and nothing restarted it when the interruption ended.
+// Both handlers restart only if isRunning is true, i.e. only when the JS
+// side currently wants sound (suspend sets it false between sessions, so
+// a route change while SteadyPoint is idle won't wake the engine).
+// ─────────────────────────────────────────────────────────────────────
+- (void)registerSteadyPointObservers
+{
+  NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+  [center addObserver:self
+             selector:@selector(steadyPointEngineConfigurationChanged:)
+                 name:AVAudioEngineConfigurationChangeNotification
+               object:self.audioEngine];
+  [center addObserver:self
+             selector:@selector(steadyPointSessionInterrupted:)
+                 name:AVAudioSessionInterruptionNotification
+               object:[AVAudioSession sharedInstance]];
+}
+
+- (void)steadyPointRestartEngineWithReason:(NSString *)reason
+{
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (!self.isRunning || self.audioEngine == nil) {
+      NSLog(@"[SteadyPoint audio] %@: engine not wanted (suspended) - not restarting", reason);
+      return;
+    }
+
+    @try {
+      // Per Apple: after a configuration change, nodes stay attached and
+      // connected with their PREVIOUS formats. The source node's own format
+      // is fixed at init and the main mixer sample-rate-converts it, so only
+      // the mixer -> output link needs re-establishing at the new hardware
+      // format (e.g. 48kHz phone speaker -> 44.1kHz Bluetooth speaker).
+      AVAudioFormat *hwFormat = [self.audioEngine.outputNode outputFormatForBus:0];
+      if (hwFormat.sampleRate > 0 && hwFormat.channelCount > 0) {
+        [self.audioEngine connect:self.audioEngine.mainMixerNode to:self.audioEngine.outputNode format:hwFormat];
+      }
+    } @catch (NSException *exception) {
+      NSLog(@"[SteadyPoint audio] %@: reconnect failed: %@", reason, exception.reason);
+    }
+
+    NSError *sessionError = nil;
+    [[AVAudioSession sharedInstance] setActive:true error:&sessionError];
+    if (sessionError != nil) {
+      NSLog(@"[SteadyPoint audio] %@: session activate error: %@", reason, [sessionError localizedDescription]);
+    }
+
+    if (![self.audioEngine isRunning]) {
+      NSError *error = nil;
+      if ([self.audioEngine startAndReturnError:&error]) {
+        NSLog(@"[SteadyPoint audio] %@: engine restarted", reason);
+      } else {
+        NSLog(@"[SteadyPoint audio] %@: engine restart FAILED: %@", reason, [error localizedDescription]);
+      }
+    } else {
+      NSLog(@"[SteadyPoint audio] %@: engine already running", reason);
+    }
+  });
+}
+
+- (void)steadyPointEngineConfigurationChanged:(NSNotification *)notification
+{
+  NSLog(@"[SteadyPoint audio] AVAudioEngineConfigurationChange received");
+  [self steadyPointRestartEngineWithReason:@"configuration change"];
+}
+
+- (void)steadyPointSessionInterrupted:(NSNotification *)notification
+{
+  NSUInteger type = [notification.userInfo[AVAudioSessionInterruptionTypeKey] unsignedIntegerValue];
+  if (type == AVAudioSessionInterruptionTypeBegan) {
+    NSLog(@"[SteadyPoint audio] interruption began");
+    return; // the system has already stopped the engine
+  }
+  NSLog(@"[SteadyPoint audio] interruption ended");
+  [self steadyPointRestartEngineWithReason:@"interruption ended"];
+}
