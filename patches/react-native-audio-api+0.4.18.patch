+// SteadyPoint patch (FIFTY-EIGHTH follow-up): Oboe has already closed the
+// disconnected stream; open a new one on the current output (Oboe's own
+// recommended recovery) and restart it if the context was running. While
+// suspended between sessions it is reopened but left paused, so a route
+// change while idle doesn't wake the audio engine.
+void AudioPlayer::onErrorAfterClose(AudioStream *oboeStream, Result error) {
+  if (error != Result::ErrorDisconnected) {
+    __android_log_print(
+        ANDROID_LOG_WARN, "SteadyPoint audio", "stream error %s (not reopened)",
+        convertToText(error));
+    return;
+  }
+  std::lock_guard<std::mutex> lock(streamMutex_);
+  if (!isInitialized_) {
+    return; // stop() ran: the context is closing
+  }
+  retiredStream_ = std::move(mStream_);
+  Result result = openStream(true);
+  if (result != Result::OK || !mStream_) {
+    __android_log_print(
+        ANDROID_LOG_ERROR, "SteadyPoint audio",
+        "output changed; reopening the stream failed: %s",
+        convertToText(result));
+    return;
+  }
+  if (shouldRun_) {
+    mStream_->requestStart();
+  }
+  __android_log_print(
+      ANDROID_LOG_INFO, "SteadyPoint audio",
+      "output changed; stream reopened at %d Hz (%s)",
+      mStream_->getSampleRate(), shouldRun_ ? "playing" : "paused");
+}
