# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1' # bumped from RN's default (13.4) — @react-native-documents/picker requires iOS 14.0+
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SteadyPointCLI' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'SteadyPointCLITests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Swift pods (e.g. MultiplatformBleAdapter, pulled in by react-native-ble-plx)
    # need DEFINES_MODULE explicitly set to YES to generate a module map when
    # consumed from Objective-C (main.m). Without this, the build can fail with
    # "module map file '.../MultiplatformBleAdapter.modulemap' not found".
    #
    # Separately, newer Xcode's "Explicitly Built Modules" (CLANG_ENABLE_EXPLICIT_MODULES)
    # dependency-scanning system doesn't reliably handle older-style CocoaPods
    # module maps yet, and can fail with the exact same "module map not found"
    # error during its ScanDependencies build phase — before any real compiling
    # happens. Disabling it here (Pods side) and in the main project (app side)
    # avoids that.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['DEFINES_MODULE'] = 'YES'
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end
  end
end
