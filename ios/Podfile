# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# FIFTY-FOURTH follow-up (RN 0.81): React Native 0.81 defaults to the New
# Architecture; this project stays on the old one (pinned libraries need it).
# Must be set before use_react_native! runs. pod install also writes
# RCTNewArchEnabled=false into Info.plist, which is what the app reads at
# runtime.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, '15.1' # bumped from RN's default (13.4) — @react-native-documents/picker requires iOS 14.0+
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SteadyPointCLI' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'SteadyPointCLITests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Swift pods (e.g. MultiplatformBleAdapter, pulled in by react-native-ble-plx)
    # need DEFINES_MODULE explicitly set to YES to generate a module map when
    # consumed from Objective-C (main.m). Without this, the build can fail with
    # "module map file '.../MultiplatformBleAdapter.modulemap' not found".
    #
    # Separately, newer Xcode's "Explicitly Built Modules" (CLANG_ENABLE_EXPLICIT_MODULES)
    # dependency-scanning system doesn't reliably handle older-style CocoaPods
    # module maps yet, and can fail with the exact same "module map not found"
    # error during its ScanDependencies build phase — before any real compiling
    # happens. Disabling it here (Pods side) and in the main project (app side)
    # avoids that.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['DEFINES_MODULE'] = 'YES'
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        # FIFTY-FOURTH follow-up: some older library pods (e.g.
        # react-native-sound 0.11.2) still declare iOS 9.0, below what
        # Xcode 26 supports — warning only; raise them to the app's 15.1.
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end

    # FIFTY-FOURTH follow-up (RN 0.81 on Xcode 26.4): fmt 11.0.2, which React
    # Native bundles, only turns off C++20 `consteval` format-string checks
    # for Apple clang < 14; Xcode 26.4's Apple clang rejects them ("Call to
    # consteval function ... is not a constant expression" in
    # fmt/format-inl.h). Turn them off for every Apple clang. Only compile-
    # time checking of format strings is affected; behaviour is unchanged.
    # Re-applied on every pod install (Pods/ is regenerated).
    fmt_base = File.join(installer.sandbox.root.to_s, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      text = File.read(fmt_base)
      patched = text.gsub('#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
                          '#elif defined(__apple_build_version__) // SteadyPoint: consteval off for all Apple clang')
      if patched != text
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
        Pod::UI.puts 'SteadyPoint: patched fmt/base.h (consteval off for Apple clang)'
      end
    end
  end
end
